{
  "ConnectionStrings": {
    // Mặc định dùng SQL Server LocalDB (cài sẵn cùng Visual Studio 2022).
    // Nếu dùng SQL Server Express, đổi thành:
    // "Server=.\\SQLEXPRESS;Database=NamSaoHRM;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=NamSaoHRM;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
