@model NhanVienCreateViewModel
@{
    ViewData["Title"] = "Cập nhật thông tin nhân viên";
    ViewData["Subtitle"] = $"NV{Model.MaNV:D3} – {Model.HoTen}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Nhân viên</a></li>
        <li class="breadcrumb-item active">Cập nhật</li>
    </ol>
</nav>
<form asp-action="Edit" asp-route-id="@Model.MaNV" method="post" novalidate>
    <input type="hidden" asp-for="MaNV" />
    <div class="card">
        <div class="card-body p-4">
            <partial name="_Form" model="Model" />
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-light border"><i class="bi bi-x-lg me-1"></i> Hủy</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Lưu thay đổi</button>
        </div>
    </div>
</form>
