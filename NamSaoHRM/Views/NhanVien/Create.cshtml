@model NhanVienCreateViewModel
@{
    ViewData["Title"] = "Thêm mới nhân viên";
    ViewData["Subtitle"] = "Nhập hồ sơ nhân viên và cấp tài khoản đăng nhập";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Nhân viên</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>
</nav>
<form asp-action="Create" method="post" novalidate>
    <div class="card">
        <div class="card-body p-4">
            <partial name="_Form" model="Model" />
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-light border"><i class="bi bi-x-lg me-1"></i> Hủy</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Lưu nhân viên</button>
        </div>
    </div>
</form>
