@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_LoginLayout";
}
<div class="login-wrap">
    <div class="login-card">
        <div class="login-brand d-none d-md-flex">
            <div>
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="brand-logo"><i class="bi bi-stars"></i></div>
                    <div>
                        <div class="brand-name">NamSao HRM</div>
                        <div class="brand-sub">Công ty CP TMĐT Năm Sao</div>
                    </div>
                </div>
                <h2 class="login-headline">Phần mềm quản lý nhân sự<br />và chấm công nội bộ</h2>
                <p class="opacity-75 mb-4">Quản lý hồ sơ nhân viên, phòng ban, chấm công hằng ngày và bảng lương tập trung trên một hệ thống duy nhất.</p>
                <ul class="list-unstyled login-features">
                    <li><i class="bi bi-people"></i> Quản lý hồ sơ nhân sự theo phòng ban</li>
                    <li><i class="bi bi-fingerprint"></i> Chấm công check-in / check-out</li>
                    <li><i class="bi bi-cash-stack"></i> Tổng hợp công và bảng lương tháng</li>
                </ul>
            </div>
            <div class="small opacity-50">© @DateTime.Today.Year Phòng Công nghệ thông tin</div>
        </div>

        <div class="login-form">
            <div class="d-md-none d-flex align-items-center gap-2 mb-4">
                <div class="brand-logo"><i class="bi bi-stars"></i></div>
                <div class="brand-name text-dark">NamSao HRM</div>
            </div>
            <h1 class="h3 fw-bold mb-1">Đăng nhập</h1>
            <p class="text-muted mb-4">Vui lòng đăng nhập bằng tài khoản được cấp.</p>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger d-flex align-items-center py-2" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        <div asp-validation-summary="ModelOnly" class="validation-plain"></div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        <button class="btn btn-outline-secondary" type="button" id="togglePwd" aria-label="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <span class="small text-muted">Quên mật khẩu? Liên hệ quản trị viên</span>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('togglePwd').addEventListener('click', function () {
            const input = document.getElementById('Password');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        });
    </script>
}
